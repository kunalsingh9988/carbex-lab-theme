{%- render 'cbx-theme' -%}
{% comment %}
  Figma Installation page body. Params: s = section.settings (optional), blocks.
{% endcomment %}

<div class="cbx-page cbx-install">
  {%- comment -%} 1 · HERO (550px) {%- endcomment -%}
  {%- assign hero_d = s.hero_image | default: 'cbx-install-hero-desktop.png' -%}
  {%- assign hero_m = s.hero_image_m | default: 'cbx-install-hero-mobile.png' -%}
  {%- assign hero_heading_v = s.hero_heading | default: 'Protect Your Paddle in Five Simple Steps' -%}
  {%- assign hero_text_v = s.hero_text | default: 'Clean the edge, position the tape, apply it gradually, and trim for a finished fit.' -%}
  {%- render 'cbx-band',
    band_h: 550,
    band_hm: 287,
    focal: '75% 55%',
    tight: true,
    img_d: hero_d,
    img_m: hero_m,
    heading: hero_heading_v,
    heading_tag: 'h1',
    heading_cls: 'cbx-h-hero',
    text: hero_text_v
  -%}

  {%- comment -%} 2 · STEPS {%- endcomment -%}
  <section class="cbx-section cbx-install__body">
    <h2 class="cbx-h-xl cbx-center">{{ s.intro_heading | default: 'Install Your Edge Guard' }}</h2>
    <p class="cbx-lead cbx-center cbx-install__intro">{{ s.intro_text | default: 'Each pack has 4 strips, one per paddle. Have a soft cloth and scissors ready.' }}</p>

    <div class="cbx-install__main">
      <picture>
        <source media="(max-width: 989px)" srcset="{% if s.main_image_m != blank %}{{ s.main_image_m | image_url: width: 1080 }}{% else %}{{ 'cbx-install-main-mobile.png' | asset_url }}{% endif %}">
        {% if s.main_image != blank %}
          <img src="{{ s.main_image | image_url: width: 1520 }}" alt="Everything you need to install edge guard tape" width="1520" height="703" loading="lazy">
        {% else %}
          <img src="{{ 'cbx-install-main.png' | asset_url }}" alt="Everything you need to install edge guard tape" width="1520" height="703" loading="lazy">
        {% endif %}
      </picture>
    </div>

    <div class="cbx-steps">
      {%- assign step_blocks = blocks | where: 'type', 'step' -%}
      {%- if step_blocks.size > 0 -%}
        {%- for block in step_blocks -%}
          <div class="cbx-step" {{ block.shopify_attributes }}>
            <div class="cbx-step__media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="290" height="288" loading="lazy">
              {%- else -%}
                <img src="{{ 'cbx-step-' | append: forloop.index | append: '.png' | asset_url }}" alt="{{ block.settings.title | escape }}" width="290" height="288" loading="lazy">
              {%- endif -%}
            </div>
            <div class="cbx-step__text">
              <p class="cbx-step__num">Step {{ forloop.index }}</p>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign step_titles = 'Clean|Peel|Center|Apply|Trim' | split: '|' -%}
        {%- assign step_texts = 'Clean and dry the paddle edge thoroughly before applying the tape.|Peel back a short section of the removable liner to begin.|Center the tape over the paddle edge and press it firmly into place.|Continue gradually around the paddle, keeping the tape centered.|Trim any excess tape at the throat, then press firmly along the full installed edge.' | split: '|' -%}
        {%- for i in (0..4) -%}
          <div class="cbx-step">
            <div class="cbx-step__media">
              <picture>
                <source media="(max-width: 989px)" srcset="{{ 'cbx-step-' | append: forloop.index | append: '-m.png' | asset_url }}">
                <img src="{{ 'cbx-step-' | append: forloop.index | append: '.png' | asset_url }}" alt="{{ step_titles[i] }}" width="290" height="288" loading="lazy">
              </picture>
            </div>
            <div class="cbx-step__text">
              <p class="cbx-step__num">Step {{ forloop.index }}</p>
              <h3>{{ step_titles[i] }}</h3>
              <p>{{ step_texts[i] }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="cbx-tip">
      <p class="cbx-tip__label">{{ s.tip_label | default: 'Step 3 tip' }}</p>
      <p class="cbx-tip__text">{{ s.tip_text | default: 'Fold the strip in half to find the middle, then start at the center of the top edge so the notches line up with the corners.' }}</p>
    </div>
  </section>

  {%- comment -%} 3 · FAQ {%- endcomment -%}
  {%- assign faq_blocks = blocks | where: 'type', 'faq' -%}
  <section class="cbx-section cbx-section--mist">
    <div class="cbx-faqwrap">
      <div class="cbx-faqwrap__side">
        <h2 class="cbx-h-xl">{{ s.faq_heading | default: 'Installation questions' }}</h2>
        <a class="cbx-faqwrap__more" href="{{ routes.root_url }}pages/faq">{{ s.faq_more_label | default: 'See all FAQs →' }}</a>
      </div>
      <div class="cbx-faqwrap__acc">
        {%- if faq_blocks.size > 0 -%}
          {%- render 'cbx-faq-items', blocks: faq_blocks, open_first: true -%}
        {%- else -%}
          <div class="cbx-acc">
            <div class="cbx-acc__line"></div>
            <details class="cbx-acc__item" open>
              <summary><p class="cbx-acc__q">Which width do I need?</p><span class="cbx-acc__icon"><img class="cbx-i-plus" src="{{ 'cbx-icon-add.svg' | asset_url }}" alt="" width="24" height="24"><img class="cbx-i-minus" src="{{ 'cbx-icon-minus.svg' | asset_url }}" alt="" width="24" height="24"></span></summary>
              <p class="cbx-acc__a">30 mm tape for 16 mm paddles, 26 mm tape for 14 mm paddles. Measure your paddle's thickness first.</p>
            </details>
            <div class="cbx-acc__line"></div>
            <details class="cbx-acc__item">
              <summary><p class="cbx-acc__q">How do I get it centered?</p><span class="cbx-acc__icon"><img class="cbx-i-plus" src="{{ 'cbx-icon-add.svg' | asset_url }}" alt="" width="24" height="24"><img class="cbx-i-minus" src="{{ 'cbx-icon-minus.svg' | asset_url }}" alt="" width="24" height="24"></span></summary>
              <p class="cbx-acc__a">Fold the strip in half to find the middle, then start at the center of the top edge so the notches line up with the corners.</p>
            </details>
            <div class="cbx-acc__line"></div>
            <details class="cbx-acc__item">
              <summary><p class="cbx-acc__q">Why is my tape lifting at the edge?</p><span class="cbx-acc__icon"><img class="cbx-i-plus" src="{{ 'cbx-icon-add.svg' | asset_url }}" alt="" width="24" height="24"><img class="cbx-i-minus" src="{{ 'cbx-icon-minus.svg' | asset_url }}" alt="" width="24" height="24"></span></summary>
              <p class="cbx-acc__a">The edge needs to be clean and fully dry before application. Peel back, clean again, and press firmly along the full strip.</p>
            </details>
            <div class="cbx-acc__line"></div>
            <details class="cbx-acc__item">
              <summary><p class="cbx-acc__q">Will the tape scuff?</p><span class="cbx-acc__icon"><img class="cbx-i-plus" src="{{ 'cbx-icon-add.svg' | asset_url }}" alt="" width="24" height="24"><img class="cbx-i-minus" src="{{ 'cbx-icon-minus.svg' | asset_url }}" alt="" width="24" height="24"></span></summary>
              <p class="cbx-acc__a">Yes — that's the point. The tape takes the scuffs and scrapes so the paddle edge underneath stays clean. Replace it when it looks worn.</p>
            </details>
            <div class="cbx-acc__line"></div>
            <details class="cbx-acc__item">
              <summary><p class="cbx-acc__q">How many paddles does one pack cover?</p><span class="cbx-acc__icon"><img class="cbx-i-plus" src="{{ 'cbx-icon-add.svg' | asset_url }}" alt="" width="24" height="24"><img class="cbx-i-minus" src="{{ 'cbx-icon-minus.svg' | asset_url }}" alt="" width="24" height="24"></span></summary>
              <p class="cbx-acc__a">Each pack includes 4 strips — one strip covers one full paddle edge.</p>
            </details>
            <div class="cbx-acc__line"></div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} 4 · CLOSING BANNER {%- endcomment -%}
  {%- render 'cbx-closing', img_d: s.closing_image, img_m: s.closing_image_m -%}
</div>

<style>
  .cbx-install__body { display: flex; flex-direction: column; align-items: center; }
  .cbx-install__intro { color: var(--cbx-body); margin-top: 16px; }
  .cbx-install__main { width: 100%; margin-top: 50px; }
  .cbx-install__main img { width: 100%; height: auto; display: block; }

  .cbx-steps { display: flex; gap: 20px; width: 100%; margin-top: 24px; align-items: stretch; }
  .cbx-step { flex: 1; min-width: 0; background: var(--cbx-mist); display: flex; flex-direction: column; overflow: hidden; }
  .cbx-step__media { height: 288px; overflow: hidden; }
  .cbx-step__media picture { display: block; width: 100%; height: 100%; }
  .cbx-step__media img { width: 100%; height: 100%; object-fit: cover; }
  .cbx-step__text { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 24px; }
  .cbx-step__num { font-size: 12px; font-weight: 600; line-height: 16px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--cbx-teal); margin: 0; }
  .cbx-step__text h3 { font-size: 24px; font-weight: 500; line-height: 32px; margin: 0; }
  .cbx-step__text p:last-child { font-size: 16px; line-height: 24px; color: var(--cbx-body); margin: 0; }
  .cbx-install__body .cbx-tip { margin-top: 20px; }

  @media screen and (max-width: 1280px) {
    .cbx-steps { flex-wrap: wrap; }
    .cbx-step { flex: 1 1 30%; }
  }
  @media screen and (max-width: 989px) {
    .cbx-install__intro { margin-top: 10px; font-size: 16px; line-height: 26px; }
    .cbx-install__main { margin-top: 30px; }
    .cbx-steps { flex-direction: column; gap: 14px; margin-top: 16px; }
    .cbx-step { flex: none; width: 100%; }
    .cbx-step__media { height: auto; aspect-ratio: 4 / 3; }
    .cbx-step__text h3 { font-size: 20px; line-height: 28px; }
    .cbx-step__text p:last-child { font-size: 15px; line-height: 24px; }
  }
</style>
