{%- render 'cbx-theme' -%}
{% comment %}
  Figma Installation page body. Params: s = section.settings (optional), blocks.
{% endcomment %}
{%- assign s = s | default: section.settings -%}
{%- assign blocks = blocks | default: section.blocks -%}

<div class="cbx-page cbx-install">
  {%- comment -%} 1 · HERO (550px) {%- endcomment -%}
  {%- assign hero_d = s.hero_image | default: 'cbx-install-hero-desktop.png' -%}
  {%- assign hero_m = s.hero_image_m | default: 'cbx-install-hero-mobile.png' -%}
  {%- assign hero_head = s.hero_heading | default: 'Protect Your Paddle in Five Simple Steps' -%}
  {%- assign hero_txt = s.hero_text | default: 'Clean the edge, position the tape, apply it gradually, and trim for a finished fit.' -%}
  {%- render 'cbx-band',
    band_h: 550,
    band_hm: 287,
    focal: '75% 55%',
    tight: true,
    img_d: hero_d,
    img_m: hero_m,
    heading: hero_head,
    heading_tag: 'h1',
    heading_cls: 'cbx-h-hero',
    text: hero_txt,
    fetchpriority: 'high'
  -%}

  {%- comment -%} 2 · STEPS {%- endcomment -%}
  {%- render 'cbx-sec-steps', s: s, blocks: blocks -%}

  {%- comment -%} 3 · FAQ {%- endcomment -%}
  {%- assign faq_blocks = blocks | where: 'type', 'faq' -%}
  {%- assign faq_head = s.faq_heading | default: 'Installation questions' -%}
  {%- render 'cbx-sec-faqwrap', s: s, blocks: faq_blocks, mist: true, preset: 'install', heading: faq_head -%}

  {%- comment -%} 4 · CLOSING BANNER {%- endcomment -%}
  {%- render 'cbx-closing', img_d: s.closing_image, img_m: s.closing_image_m -%}
</div>
