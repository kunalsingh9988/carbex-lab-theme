{% liquid
  assign s = s | default: section.settings
  assign shop_collection = collections[s.collection]
  if shop_collection == blank or shop_collection.products_count == 0
    assign shop_collection = collections.all
  endif
%}
<main class="carbex-shop-page">
  <section class="carbex-shop-hero"><div class="carbex-shop-hero__copy"><p class="carbex-eyebrow">{{ s.eyebrow | default: 'CARBEX LAB / SHOP' | escape }}</p><h1>{{ s.heading | default: 'Protection for the way you play.' | escape }}</h1><p>{{ s.intro | default: 'Considered materials, clean installation, and practical care for every session.' }}</p><a class="carbex-shop-button carbex-shop-button--dark" href="#carbex-shop-products">{{ s.button_label | default: 'Shop the range' | escape }} <span aria-hidden="true">&#8599;</span></a></div><div class="carbex-shop-hero__media">{% if s.hero_image != blank %}{{ s.hero_image | image_url: width: 2880 | image_tag: loading: 'eager', widths: '1400,2000,2880', alt: s.heading }}{% else %}<img src="{{ 'carbex-hero-product.png' | asset_url }}" loading="eager" width="2880" height="2880" alt="{{ s.heading | default: 'Protection for the way you play.' | escape }}">{% endif %}</div></section>
  {% if s.show_intro != false %}<section class="carbex-shop-intro"><p class="carbex-eyebrow">{{ s.range_eyebrow | default: 'THE CARBEX RANGE' | escape }}</p><h2>{{ s.range_heading | default: 'Small upgrades. Better equipment days.' | escape }}</h2><p>{{ s.range_text | default: 'Start with protection, add considered care, and keep your paddle ready for the next point.' }}</p></section>{% endif %}
  <section id="carbex-shop-products" class="carbex-shop-products"><div class="carbex-shop-products__head"><h2>{{ s.products_heading | default: 'Shop Carbex Lab' | escape }}</h2><a href="{{ routes.all_products_collection_url }}">{{ s.view_all_label | default: 'View all' | escape }} <span aria-hidden="true">&#8599;</span></a></div><div class="carbex-shop-grid">{% if shop_collection != blank and shop_collection.products_count > 0 %}{% for product in shop_collection.products limit: 8 %}<a class="carbex-shop-card" href="{{ product.url }}"><div class="carbex-shop-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: product.featured_image.alt | default: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'carbex-shop-card__placeholder' }}{% endif %}</div><div class="carbex-shop-card__meta"><h3>{{ product.title | escape }}</h3><span>{{ product.price | money }}</span></div><p>{% if product.description != blank %}{{ product.description | strip_html | truncate: 84 }}{% else %}{{ s.fallback_card_text | default: 'Practical protection and care for the equipment you trust.' | escape }}{% endif %}</p></a>{% endfor %}{% else %}<p class="carbex-shop-empty">{{ s.empty_label | default: 'No products yet — check back soon.' | escape }}</p>{% endif %}</div></section>
  {% if s.show_feature != false %}<section class="carbex-shop-feature"><div class="carbex-shop-feature__media">{% if s.feature_image != blank %}{{ s.feature_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '1200,1800,2400', alt: s.feature_heading }}{% else %}<img src="{{ 'carbex-lifestyle-court.png' | asset_url }}" loading="lazy" width="2400" height="1000" alt="{{ s.feature_heading | default: 'Keep your gear ready.' | escape }}">{% endif %}</div><div class="carbex-shop-feature__copy"><p class="carbex-eyebrow">{{ s.feature_eyebrow | default: 'READY FOR THE NEXT POINT' | escape }}</p><h2>{{ s.feature_heading | default: 'Keep your gear ready.' | escape }}</h2><p>{{ s.feature_text | default: 'Reliable protection and care for the equipment you trust.' }}</p><a class="carbex-shop-button carbex-shop-button--light" href="{{ routes.all_products_collection_url }}">{{ s.feature_button | default: 'Explore products' | escape }} <span aria-hidden="true">&#8599;</span></a></div></section>{% endif %}
</main>
{% stylesheet %}
  .carbex-shop-page { background: #f8f8f8; color: #020202; }
  .carbex-shop-hero { align-items: stretch; display: grid; grid-template-columns: .9fr 1.1fr; min-height: min(70vw, 760px); }
  .carbex-shop-hero__copy { align-self: center; padding: clamp(48px, 8vw, 120px) max(24px, 8vw); }
  .carbex-shop-hero h1, .carbex-shop-intro h2, .carbex-shop-feature h2 { font-size: clamp(2.3rem, 5vw, 5.6rem); font-weight: 500; letter-spacing: 0; line-height: .98; margin: 0; max-width: 10ch; }
  .carbex-shop-hero__copy > p:not(.carbex-eyebrow), .carbex-shop-feature__copy > p:not(.carbex-eyebrow) { color: #3b3f45; line-height: 1.7; margin: 24px 0 0; max-width: 38ch; }
  .carbex-eyebrow { color: #13a9bd; font-size: .72rem; font-weight: 700; letter-spacing: .16em; margin: 0 0 18px; text-transform: uppercase; }
  .carbex-shop-hero__media { background: #f8f8f8; min-height: 100%; }
  .carbex-shop-hero__media img { display: block; height: 100%; object-fit: cover; width: 100%; }
  .carbex-shop-button { align-items: center; display: inline-flex; gap: 18px; margin-top: 30px; padding: 13px 24px; text-decoration: none; }
  .carbex-shop-button--dark { background: #0d1622; color: #fff; }
  .carbex-shop-button--light { border: 1px solid rgba(255,255,255,.65); color: #fff; }
  .carbex-shop-intro { margin: 0 auto; max-width: 680px; padding: clamp(72px, 10vw, 140px) 24px clamp(48px, 7vw, 92px); text-align: center; }
  .carbex-shop-intro h2 { font-size: clamp(2rem, 4vw, 4rem); margin: 0 auto; max-width: 12ch; }
  .carbex-shop-intro > p:last-child { color: #3b3f45; line-height: 1.7; margin: 22px auto 0; max-width: 48ch; }
  .carbex-shop-products { margin: 0 auto; max-width: 1260px; padding: 0 24px clamp(84px, 10vw, 140px); }
  .carbex-shop-products__head { align-items: end; display: flex; justify-content: space-between; margin-bottom: 26px; }
  .carbex-shop-products__head h2 { font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 500; margin: 0; }
  .carbex-shop-products__head a { color: inherit; font-size: .78rem; font-weight: 700; text-decoration: none; }
  .carbex-shop-grid { display: grid; gap: 16px; grid-template-columns: repeat(4, 1fr); }
  .carbex-shop-card { color: inherit; text-decoration: none; }
  .carbex-shop-card__media { aspect-ratio: 1; background: #f8f8f8; overflow: hidden; }
  .carbex-shop-card__media img, .carbex-shop-card__placeholder { display: block; height: 100%; object-fit: cover; transition: transform .3s ease; width: 100%; }
  .carbex-shop-empty { color: #3b3f45; font-size: .9rem; grid-column: 1 / -1; margin: 0; padding: 24px 0; }
  .carbex-shop-card:hover .carbex-shop-card__media img { transform: scale(1.03); }
  .carbex-shop-card__meta { align-items: start; display: flex; gap: 12px; justify-content: space-between; padding-top: 14px; }
  .carbex-shop-card h3 { font-size: .9rem; font-weight: 700; margin: 0; }
  .carbex-shop-card__meta span, .carbex-shop-card p { color: #3b3f45; font-size: .75rem; }
  .carbex-shop-card p { line-height: 1.5; margin: 8px 0 0; }
  .carbex-shop-feature { background: #0d1622; color: #fff; display: grid; grid-template-columns: 1.35fr .65fr; min-height: 520px; }
  .carbex-shop-feature__media img { display: block; height: 100%; object-fit: cover; width: 100%; }
  .carbex-shop-feature__copy { align-self: center; padding: 64px max(24px, 7vw); }
  .carbex-shop-feature__copy .carbex-eyebrow { color: #4dd0e1; }
  .carbex-shop-feature h2 { font-size: clamp(2.2rem, 4vw, 4.5rem); }
  .carbex-shop-feature__copy > p:not(.carbex-eyebrow) { color: rgba(255,255,255,.76); }
  @media (max-width: 749px) { .carbex-shop-hero, .carbex-shop-feature { grid-template-columns: 1fr; } .carbex-shop-hero__media { min-height: 380px; order: -1; } .carbex-shop-hero__copy { padding: 54px 24px 72px; } .carbex-shop-grid { grid-template-columns: repeat(2, 1fr); gap: 22px 12px; } .carbex-shop-products { padding-inline: 16px; } .carbex-shop-feature__media { min-height: 300px; } .carbex-shop-feature__copy { padding: 58px 24px 72px; } }
{% endstylesheet %}
