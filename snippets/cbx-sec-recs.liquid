{%- comment -%}
  Carbex "You may also like" recommendations. Params:
    product — product object (falls back to featured/first product)
    s       — hash exposing recs_collection, recs_heading
{%- endcomment -%}
{%- assign s = s | default: section.settings -%}
{%- if product == blank -%}
  {%- assign product = all_products['carbex-lab-pickleball-paddle-edge-guard-tape'] | default: collections.all.products.first -%}
{%- endif -%}
{%- assign recs_collection = collections[s.recs_collection] -%}
{%- if recs_collection == blank or recs_collection.products_count == 0 -%}
  {%- assign recs_collection = collections.all -%}
{%- endif -%}

  {%- comment -%} ============ RECOMMENDATIONS ============ {%- endcomment -%}
  {% if s.show_recs != false %}
  <section class="cbx-page cbx-pdp__recs" data-recs data-recs-product="{{ product.id }}">
    <div class="cbx-pdp__recs-inner">
      <h2 class="cbx-h-xl cbx-center">{{ s.recs_heading | default: 'You may also like' | escape }}</h2>
      <div class="cbx-pdp__recs-grid" data-recs-grid>
        {% assign recs_shown = 0 %}
        {% for item in recs_collection.products %}
          {% if item.id != product.id and recs_shown < 4 %}
            <a class="carbex-recs-card" href="{{ item.url }}">
              <div class="carbex-recs-card__media">
                {% if item.featured_image %}{{ item.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: item.title }}{% endif %}
              </div>
              <div class="carbex-recs-card__meta"><h3>{{ item.title | escape }}</h3><span>{{ item.price | money }}</span></div>
            </a>
            {% assign recs_shown = recs_shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}


<style>
  .cbx-pdp__recs-inner { padding: 0 200px 100px; }
  .cbx-pdp__recs-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 40px; }
  .carbex-recs-card { display: flex; flex-direction: column; background: var(--cbx-mist); overflow: hidden; color: var(--cbx-ink); }
  .carbex-recs-card__media { aspect-ratio: 1; overflow: hidden; }
  .carbex-recs-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .carbex-recs-card__meta { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px 20px; }
  .carbex-recs-card__meta h3 { font-size: 16px; font-weight: 500; line-height: 24px; margin: 0; }
  .carbex-recs-card__meta span { font-size: 15px; line-height: 22px; color: var(--cbx-body); font-weight: 600; }

  @media screen and (max-width: 1280px) {
    .cbx-pdp__recs-inner { padding: 0 60px 80px; }
  }
  @media screen and (max-width: 989px) {
    .cbx-pdp__recs-inner { padding: 0 20px 60px; }
    .cbx-pdp__recs-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 28px; }
  }
</style>

<script>
  (() => {
    const recs = document.querySelector('[data-recs][data-recs-product="{{ product.id }}"]');
    if (!recs) return;
    fetch('{{ routes.product_recommendations_url }}?section_id=carbex-recommendations&product_id={{ product.id }}&limit=4&intent=related')
      .then((res) => res.text())
      .then((html) => {
        const cards = new DOMParser().parseFromString(html, 'text/html').querySelectorAll('.carbex-recs-card');
        if (cards.length) {
          const grid = recs.querySelector('[data-recs-grid]');
          grid.innerHTML = '';
          cards.forEach((card) => grid.appendChild(card));
        }
      })
      .catch(() => {});
  })();
</script>
