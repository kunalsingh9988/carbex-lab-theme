{% comment %}
  Carbex "Our approach" — oversized statement left, paddle image right.
  Params: s — hash exposing approach_eyebrow, approach_heading, approach_text,
    approach_image (image object or asset filename).
{% endcomment %}
{%- assign s = s | default: section.settings -%}

<section class="cbx-section cbx-approach">
  <div class="cbx-approach__text">
    <p class="cbx-eyebrow cbx-eyebrow--muted">{{ s.approach_eyebrow | default: 'Our approach' }}</p>
    <h2 class="cbx-approach__statement">{{ s.approach_heading | default: "GOOD PADDLE CARE DOESN'T NEED TO BE COMPLICATED." }}</h2>
    <p class="cbx-approach__body">{{ s.approach_text | default: 'We look at how paddles actually wear: edge contact, scuffs and everyday grime. Then we build simple products around it that are easy to understand and easy to use. Clear sizing, honest details, and nothing overstated.' }}</p>
  </div>
  <div class="cbx-approach__media">
    {%- if s.approach_image != blank -%}
      <img src="{{ s.approach_image | image_url: width: 776 }}" alt="{{ s.approach_heading | escape }}" width="388" height="660" loading="lazy">
    {%- else -%}
      <img src="{{ 'cbx-paddle-cutout.png' | asset_url }}" alt="CARBEX LAB paddle" width="388" height="660" loading="lazy">
    {%- endif -%}
  </div>
</section>

<style>
  .cbx-approach { display: flex; gap: 80px; align-items: center; }
  .cbx-approach__text { width: 880px; display: flex; flex-direction: column; gap: 28px; }
  .cbx-approach__statement {
    font-size: 76px; font-weight: 700; line-height: 80px;
    letter-spacing: -0.76px; margin: 0; max-width: 880px;
  }
  .cbx-approach__body { font-size: 18px; line-height: 30px; color: var(--cbx-body); margin: 0; max-width: 680px; }
  .cbx-approach__media { flex: 1; display: flex; align-items: center; justify-content: center; }
  .cbx-approach__media img { width: 388px; height: 660px; object-fit: contain; }

  @media screen and (max-width: 1280px) {
    .cbx-approach__text { width: 55%; }
    .cbx-approach__statement { font-size: 56px; line-height: 62px; }
  }
  @media screen and (max-width: 989px) {
    .cbx-approach { flex-direction: column; gap: 40px; align-items: flex-start; }
    .cbx-approach__text { width: 100%; gap: 20px; }
    .cbx-approach__statement { font-size: 38px; line-height: 42px; letter-spacing: -0.38px; }
    .cbx-approach__body { font-size: 16px; line-height: 26px; max-width: none; }
    .cbx-approach__media { width: 100%; }
    .cbx-approach__media img { width: 200px; height: 340px; }
  }
</style>
