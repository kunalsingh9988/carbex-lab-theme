{% comment %}
  Carbex "Shop CARBEX LAB" two-card strip — product card + secondary card.
  Params: s — hash exposing shop/card keys:
    shop_heading    section heading (default 'Shop CARBEX LAB')
    product_1       product handle for card 1 (falls back to featured/first product)
    card1_image     image override for card 1
    card1_title     title override
    card1_desc      description
    card1_price     price fallback text when no product
    card1_btn       button label
    card2_image / card2_title / card2_desc / card2_tag / card2_btn / card2_btn_url
{% endcomment %}
{%- assign s = s | default: section.settings -%}
{%- assign product_1 = all_products[s.product_1] -%}
{%- if product_1 == blank -%}
  {%- assign product_1 = all_products['carbex-lab-pickleball-paddle-edge-guard-tape'] | default: collections.all.products.first -%}
{%- endif -%}

<section class="cbx-section cbx-section--wide cbx-shop">
  <h2 class="cbx-h-xl cbx-center cbx-shop__title">{{ s.shop_heading | default: 'Shop CARBEX LAB' }}</h2>
  <div class="cbx-shop__grid">
    <div class="cbx-card">
      <a class="cbx-card__media" href="{{ product_1.url | default: '#' }}">
        {%- if s.card1_image != blank -%}
          <img src="{{ s.card1_image | image_url: width: 1172 }}" alt="{{ s.card1_title | escape }}" width="586" height="586" loading="lazy">
        {%- elsif product_1.featured_image -%}
          <img src="{{ product_1.featured_image | image_url: width: 1172 }}" alt="{{ product_1.title | escape }}" width="586" height="586" loading="lazy">
        {%- else -%}
          <img src="{{ 'cbx-card-paddle.png' | asset_url }}" alt="{{ s.card1_title | escape }}" width="586" height="586" loading="lazy">
        {%- endif -%}
      </a>
      <div class="cbx-card__body">
        <h3 class="cbx-h-sm">{{ s.card1_title | default: product_1.title | default: 'Paddle Edge Guard Tape' }}</h3>
        <p class="cbx-card__desc">{{ s.card1_desc | default: 'A replaceable protective layer applied around the outside edge of a pickleball paddle.' }}</p>
        <p class="cbx-card__price">
          {%- if product_1 != blank -%}
            {%- assign opt = product_1.options_with_values.first -%}
            {%- if product_1.variants.size > 1 and opt.values.size > 1 -%}
              {{ opt.values | join: ' or ' }} · {{ product_1.price | money }}
            {%- else -%}
              {{ product_1.price | money }}
            {%- endif -%}
          {%- else -%}
            {{ s.card1_price | default: '26 mm or 30 mm · $15.99' }}
          {%- endif -%}
        </p>
        <a class="cbx-btn cbx-btn--dark cbx-card__btn" href="{{ product_1.url | default: routes.all_products_collection_url }}">{{ s.card1_btn | default: 'Shop Edge Guard' }}</a>
      </div>
    </div>

    <div class="cbx-card">
      <div class="cbx-card__media">
        {%- if s.card2_image != blank -%}
          <img src="{{ s.card2_image | image_url: width: 1172 }}" alt="{{ s.card2_title | escape }}" width="586" height="586" loading="lazy">
        {%- else -%}
          <img src="{{ 'cbx-card-cleaner.png' | asset_url }}" alt="{{ s.card2_title | escape }}" width="586" height="586" loading="lazy">
        {%- endif -%}
      </div>
      <div class="cbx-card__body">
        <h3 class="cbx-h-sm">{{ s.card2_title | default: 'Paddle Surface Cleaner' }}</h3>
        <p class="cbx-card__desc">{{ s.card2_desc | default: 'Remove everyday dirt and grime without overcomplicating paddle care.' }}</p>
        <p class="cbx-card__tag">{{ s.card2_tag | default: 'Coming soon' }}</p>
        <a class="cbx-btn cbx-btn--outline cbx-card__btn" href="{{ s.card2_btn_url | default: routes.root_url | append: 'pages/contact' }}">{{ s.card2_btn | default: 'Notify me' }}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cbx-shop { display: flex; flex-direction: column; gap: 30px; align-items: center; }
  .cbx-shop__title { margin-bottom: 0; }
  .cbx-shop__grid { display: flex; gap: 30px; justify-content: center; align-items: stretch; }
  .cbx-card { background: var(--cbx-mist); width: 586px; display: flex; flex-direction: column; overflow: hidden; }
  .cbx-card__media { display: block; aspect-ratio: 1; overflow: hidden; }
  .cbx-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .cbx-card__body { display: flex; flex-direction: column; gap: 14px; padding: 30px 30px 36px; align-items: flex-start; flex: 1; }
  .cbx-card__desc { font-size: 18px; line-height: 28px; color: var(--cbx-body); margin: 0; }
  .cbx-card__price { font-size: 20px; font-weight: 600; line-height: 30px; margin: 0; }
  .cbx-card__tag { font-size: 14px; font-weight: 600; line-height: 20px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--cbx-muted); margin: 0; }
  .cbx-card__btn { margin-top: 6px; }

  @media screen and (max-width: 1280px) {
    .cbx-card { width: calc(50% - 15px); }
    .cbx-shop__grid { width: 100%; }
  }
  @media screen and (max-width: 989px) {
    /* Cards become horizontal rows */
    .cbx-shop__grid { flex-direction: column; gap: 12px; }
    .cbx-card { flex-direction: row; align-items: stretch; width: 100%; }
    .cbx-card__media { width: 140px; flex: none; aspect-ratio: auto; }
    .cbx-card__media img { height: 100%; }
    .cbx-card__body { padding: 16px; gap: 8px; }
    .cbx-card .cbx-h-sm { font-size: 18px; line-height: 26px; }
    .cbx-card__desc { display: none; }
    .cbx-card__price { font-size: 16px; line-height: 24px; }
    .cbx-card__tag { font-size: 12px; line-height: 18px; letter-spacing: 1.2px; }
    .cbx-card__btn { margin-top: 2px; font-size: 14px; line-height: 20px; padding: 10px 20px; }
  }
</style>
