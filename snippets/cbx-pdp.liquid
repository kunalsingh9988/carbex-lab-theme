{%- render 'cbx-theme' -%}
{% liquid
  assign s = s | default: section.settings
  assign section_id = section_id | default: section.id
  assign blocks = blocks | default: section.blocks
  if product == blank
    assign product = all_products['carbex-lab-pickleball-paddle-edge-guard-tape'] | default: collections.all.products.first
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_assets = 'carbex-pouch-26-front.png,carbex-pouch-26-back.png,carbex-pouch-26-with-tapes.png,carbex-tape-float.png,carbex-paddle-edge.png,carbex-tape-peel.png' | split: ','
  if product.handle contains 'paddle'
    assign gallery_assets = 'carbex-paddle-front.png,carbex-paddle-front-angle.png,carbex-paddle-surface.png,carbex-paddle-back.png,carbex-paddle-back-angle.png,carbex-paddle-detail-1.png' | split: ','
  endif
  assign bundle_collection = collections[s.bundle_collection]
  if bundle_collection == blank or bundle_collection.products_count == 0
    assign bundle_collection = collections.all
  endif
  assign recs_collection = collections[s.recs_collection]
  if recs_collection == blank or recs_collection.products_count == 0
    assign recs_collection = collections.all
  endif
%}

<div class="cbx-page cbx-pdp" data-product-id="{{ product.id }}">
  {%- comment -%} ============ SECTION 2 · PRODUCT ============ {%- endcomment -%}
  <section class="cbx-pdp__intro">
    <div class="cbx-pdp__gallery" data-gallery>
      <div class="cbx-pdp__main">
        {% if product.images.size > 0 %}
          {% for image in product.images %}
            <figure class="cbx-pdp__img{% unless forloop.first %} is-hidden{% endunless %}" data-gallery-image="{{ forloop.index0 }}">
              {{ image | image_url: width: 1560 | image_tag: loading: 'lazy', widths: '390,780,1170,1560', sizes: '(min-width: 990px) 780px, 100vw', alt: image.alt | default: product.title }}
            </figure>
          {% endfor %}
        {% else %}
          {% for asset in gallery_assets %}
            <figure class="cbx-pdp__img{% unless forloop.first %} is-hidden{% endunless %}" data-gallery-image="{{ forloop.index0 }}">
              <img src="{{ asset | asset_url }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="780" height="780" alt="{{ product.title | escape }} product view {{ forloop.index }}">
            </figure>
          {% endfor %}
        {% endif %}
        <img class="cbx-pdp__dots" src="{{ 'cbx-dots-2.svg' | asset_url }}" alt="" width="72" height="7" aria-hidden="true">
      </div>
      <div class="cbx-pdp__thumbs" role="list" aria-label="Product images">
        {% if product.images.size > 0 %}
          {% for image in product.images %}
            <button type="button" class="cbx-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
            </button>
          {% endfor %}
        {% else %}
          {% for asset in gallery_assets %}
            <button type="button" class="cbx-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              <img src="{{ asset | asset_url }}" loading="lazy" width="120" height="120" alt="">
            </button>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="cbx-pdp__buy">
      <h1 class="cbx-h-md">{{ product.title | escape }}</h1>
      {% assign rating_v = s.rating | default: '4.2 ★ · 206 ratings on Amazon' %}
      {% if rating_v != blank %}
        <p class="cbx-pdp__rating">{{ rating_v | escape }}</p>
      {% endif %}
      <p class="cbx-pdp__price" data-product-price>{{ current_variant.price | default: 0 | money }}</p>
      <p class="cbx-pdp__desc">{{ s.description | default: product.description | strip_html | truncate: 220 }}</p>

      {% form 'product', product, class: 'cbx-pdp__form' %}
        {% unless product.has_only_default_variant %}
          {%- assign product_form_id = 'CbxProductForm-' | append: section_id -%}
          <select id="CbxVariant-{{ section_id }}" name="id" data-variant-select class="cbx-pdp__variant-select" aria-hidden="true" tabindex="-1">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-cents="{{ variant.price }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}{% unless variant.available %} · {{ s.sold_out_label | default: 'Sold out' | escape }}{% endunless %}
              </option>
            {% endfor %}
          </select>

          {% for option in product.options_with_values %}
            {% assign opt_name_down = option.name | downcase %}
            {% assign is_color = false %}
            {% if opt_name_down contains 'color' or opt_name_down contains 'colour' %}
              {% assign is_color = true %}
            {% endif %}
            <div class="cbx-opt" data-option-index="{{ forloop.index0 }}">
              <p class="cbx-opt__label">{{ option.name }}: <strong data-option-value-label>{{ option.selected_value }}</strong></p>
              <div class="cbx-opt__values{% if is_color %} cbx-opt__values--swatches{% endif %}" role="radiogroup" aria-label="{{ option.name }}">
                {% for value in option.values %}
                  {% assign active = false %}
                  {% if option.selected_value == value %}{% assign active = true %}{% endif %}
                  {% if is_color %}
                    {%- assign vh = value | handleize -%}
                    {%- assign swatch_asset = '' -%}
                    {%- if vh contains 'black' -%}{%- assign swatch_asset = 'cbx-swatch-black.svg' -%}
                    {%- elsif vh contains 'white' -%}{%- assign swatch_asset = 'cbx-swatch-white.svg' -%}
                    {%- elsif vh contains 'silver' -%}{%- assign swatch_asset = 'cbx-swatch-silver.svg' -%}
                    {%- elsif vh contains 'ice' -%}{%- assign swatch_asset = 'cbx-swatch-iceblue.svg' -%}
                    {%- elsif vh contains 'blue' -%}{%- assign swatch_asset = 'cbx-swatch-blue.svg' -%}
                    {%- elsif vh contains 'green' -%}{%- assign swatch_asset = 'cbx-swatch-green.svg' -%}
                    {%- elsif vh contains 'red' -%}{%- assign swatch_asset = 'cbx-swatch-red.svg' -%}
                    {%- elsif vh contains 'orange' -%}{%- assign swatch_asset = 'cbx-swatch-orange.svg' -%}
                    {%- endif -%}
                    <button type="button" class="cbx-swatch{% if active %} is-active{% endif %}" data-option-value="{{ value | escape }}" aria-label="{{ value | escape }}" aria-pressed="{{ active }}">
                      {% if swatch_asset != '' %}<img src="{{ swatch_asset | asset_url }}" alt="" width="44" height="44">{% else %}<span class="cbx-swatch__dot" style="background: {{ vh | replace: '-', ' ' }}"></span>{% endif %}
                    </button>
                  {% else %}
                    <button type="button" class="cbx-pill{% if active %} is-active{% endif %}" data-option-value="{{ value | escape }}" aria-pressed="{{ active }}">{{ value }}</button>
                  {% endif %}
                {% endfor %}
              </div>
              {% if forloop.last %}
                <p class="cbx-opt__hint">{{ s.width_hint | default: "30 mm tape for 16 mm paddles · 26 mm tape for 14 mm paddles. Measure your paddle's thickness before ordering." | escape }}</p>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- comment -%} Product has no options — render the Figma Color + Width rows {%- endcomment -%}
          {% if s.show_option_rows != false %}
            {%- assign color_names = 'Carbon Black|Carbon White|Carbon Silver|Carbon Blue|Carbon Ice Blue|Carbon Green|Carbon Red|Carbon Orange' | split: '|' -%}
            {%- assign swatch_files = 'cbx-swatch-black.svg|cbx-swatch-white.svg|cbx-swatch-silver.svg|cbx-swatch-blue.svg|cbx-swatch-iceblue.svg|cbx-swatch-green.svg|cbx-swatch-red.svg|cbx-swatch-orange.svg' | split: '|' -%}
            {%- assign h = product.handle | downcase -%}
            {%- assign active_color = s.color_value | default: 'Carbon Blue' -%}
            {%- for cname in color_names -%}
              {%- assign ckey = cname | split: ' ' | last | downcase -%}
              {%- if h contains ckey -%}{%- assign active_color = cname -%}{%- endif -%}
            {%- endfor -%}
            <div class="cbx-opt">
              <p class="cbx-opt__label">Color: <strong>{{ active_color }}</strong></p>
              <div class="cbx-opt__values cbx-opt__values--swatches">
                {%- for cname in color_names -%}
                  <span class="cbx-swatch{% if cname == active_color %} is-active{% endif %}" role="img" aria-label="{{ cname }}">
                    <img src="{{ swatch_files[forloop.index0] | asset_url }}" alt="" width="44" height="44">
                  </span>
                {%- endfor -%}
              </div>
            </div>

            {%- assign sib_handle = '' -%}
            {%- assign active_width = '' -%}
            {%- if h contains '26' -%}
              {%- assign active_width = '26 mm' -%}
              {%- assign sib_handle = product.handle | replace: '26', '30' -%}
            {%- elsif h contains '30' -%}
              {%- assign active_width = '30 mm' -%}
              {%- assign sib_handle = product.handle | replace: '30', '26' -%}
            {%- endif -%}
            {%- assign sib_product = nil -%}
            {%- if sib_handle != '' -%}{%- assign sib_product = all_products[sib_handle] -%}{%- endif -%}
            {%- assign width_active_v = active_width | default: s.width_value | default: '30 mm' -%}
            <div class="cbx-opt">
              <p class="cbx-opt__label">Width: <strong>{{ width_active_v }}</strong></p>
              <div class="cbx-opt__values">
                {%- assign p26_href = '' -%}
                {%- assign p30_href = '' -%}
                {%- if sib_product != blank -%}
                  {%- if active_width == '26 mm' -%}
                    {%- assign p30_href = sib_product.url -%}
                  {%- else -%}
                    {%- assign p26_href = sib_product.url -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if p26_href != '' -%}
                  <a class="cbx-pill" href="{{ p26_href }}">26 mm</a>
                {%- else -%}
                  <span class="cbx-pill{% if width_active_v == '26 mm' %} is-active{% endif %}">26 mm</span>
                {%- endif -%}
                {%- if p30_href != '' -%}
                  <a class="cbx-pill" href="{{ p30_href }}">30 mm</a>
                {%- else -%}
                  <span class="cbx-pill{% if width_active_v == '30 mm' %} is-active{% endif %}">30 mm</span>
                {%- endif -%}
              </div>
              <p class="cbx-opt__hint">{{ s.width_hint | default: "30 mm tape for 16 mm paddles · 26 mm tape for 14 mm paddles. Measure your paddle's thickness before ordering." | escape }}</p>
            </div>
          {% endif %}
        {% endunless %}

        {% if bundle_collection.products.size > 1 and s.show_bundle != false %}
          <div class="cbx-pdp__bundle">
            <p class="cbx-pdp__bundle-heading">{{ s.bundle_heading | default: 'Make it a bundle' | escape }}</p>
            <div class="cbx-pdp__bundle-list">
              {% assign bundle_shown = 0 %}
              {% for item in bundle_collection.products %}
                {% if item.id != product.id and bundle_shown < 4 %}
                  {% assign bundle_variant = item.selected_or_first_available_variant %}
                  <label class="cbx-pdp__bundle-item{% unless bundle_variant.available %} is-soldout{% endunless %}">
                    <input type="checkbox" data-bundle-item value="{{ bundle_variant.id }}" data-cents="{{ bundle_variant.price }}" {% unless bundle_variant.available %}disabled{% endunless %}>
                    {% if item.featured_image %}
                      {{ item.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: item.title }}
                    {% endif %}
                    <span class="cbx-pdp__bundle-info">
                      <strong>{{ item.title | escape }}</strong>
                      <em>{{ bundle_variant.price | money }}{% unless bundle_variant.available %} · {{ s.sold_out_label | default: 'Sold out' | escape }}{% endunless %}</em>
                    </span>
                    <span class="cbx-pdp__bundle-add" aria-hidden="true">+</span>
                  </label>
                  {% assign bundle_shown = bundle_shown | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="cbx-pdp__buyrow">
          <div class="cbx-pdp__qty">
            <button type="button" class="cbx-pdp__qty-btn" data-qty-change="-1" aria-label="Decrease quantity">−</button>
            <input id="CbxQty-{{ section_id }}" type="number" name="quantity" value="1" min="1" aria-label="{{ s.qty_label | default: 'Quantity' | escape }}">
            <button type="button" class="cbx-pdp__qty-btn" data-qty-change="1" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="cbx-pdp__atc" {% unless current_variant.available %}disabled{% endunless %}>
            <span data-add-label>{% if current_variant.available %}{{ s.add_to_cart_label | default: 'Add to Cart' | escape }}{% else %}{{ s.sold_out_label | default: 'Sold out' | escape }}{% endif %}</span>
            <span class="cbx-pdp__atc-total"><span data-add-price>{{ current_variant.price | default: 0 | money }}</span></span>
          </button>
        </div>
        <div class="cbx-pdp__msg" role="status" aria-live="polite"></div>
      {% endform %}

      <figure class="cbx-quote cbx-quote--sm cbx-pdp__quote">
        <blockquote class="cbx-quote__text">{{ s.quote | default: '“I’ve been using it for 4months now and it is holding up very well.”' | escape }}</blockquote>
        <figcaption class="cbx-quote__meta">{{ s.quote_cite | default: 'Vlad · Verified Amazon review' | escape }}</figcaption>
      </figure>

      {% assign fact_blocks = blocks | where: 'type', 'fact' %}
      <div class="cbx-facts">
        <p class="cbx-facts__title">{{ s.facts_heading | default: 'Confirmed product facts' }}</p>
        {% if fact_blocks.size > 0 %}
          {% for block in fact_blocks %}
            <dl class="cbx-fact" {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}</dd></dl>
          {% endfor %}
        {% else %}
          <dl class="cbx-fact"><dt>Package</dt><dd>4 strips</dd></dl>
          <dl class="cbx-fact"><dt>Strip length</dt><dd>About 800 mm each</dd></dl>
          <dl class="cbx-fact"><dt>Coverage</dt><dd>One strip covers one paddle</dd></dl>
          <dl class="cbx-fact"><dt>Weight</dt><dd>About 0.25 oz per strip</dd></dl>
          <dl class="cbx-fact"><dt>Thickness</dt><dd>About 0.525 mm, excluding backing</dd></dl>
          <dl class="cbx-fact"><dt>Profile</dt><dd>Notched edge; trim to fit</dd></dl>
          <dl class="cbx-fact"><dt>Widths</dt><dd>26 mm (14 mm paddles) · 30 mm (16 mm paddles)</dd></dl>
        {% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ============ SECTION 3 · MECHANISM BANNER ============ {%- endcomment -%}
  {% if s.show_mechanism != false %}
  <section class="cbx-mech">
    <div class="cbx-mech__media">
      <picture>
        <source media="(max-width: 989px)" srcset="{% if s.mech_image_m != blank %}{{ s.mech_image_m | image_url: width: 1080 }}{% else %}{{ 'cbx-mech-banner-m.png' | asset_url }}{% endif %}">
        {% if s.mech_image != blank %}
          <img src="{{ s.mech_image | image_url: width: 1920 }}" alt="Close-up of Edge Guard Tape wrapped around a paddle edge, ending at the throat" width="1920" height="800" loading="lazy">
        {% else %}
          <img src="{{ 'cbx-mech-banner.png' | asset_url }}" alt="Close-up of Edge Guard Tape wrapped around a paddle edge, ending at the throat" width="1920" height="800" loading="lazy">
        {% endif %}
      </picture>

      {%- comment -%} Desktop callouts (hairline + point + numeral), positions from Figma 1920×800 {%- endcomment -%}
      <div class="cbx-mech__callout cbx-mech__callout--1" aria-hidden="true">
        <img class="cbx-mech__line" src="{{ 'cbx-hairline-1.svg' | asset_url }}" alt="" width="190" height="171">
        <img class="cbx-mech__point" src="{{ 'cbx-point.svg' | asset_url }}" alt="" width="7" height="7">
        <span class="cbx-mech__num cbx-mono">01</span>
      </div>
      <div class="cbx-mech__callout cbx-mech__callout--2" aria-hidden="true">
        <img class="cbx-mech__line" src="{{ 'cbx-hairline-2.svg' | asset_url }}" alt="" width="300" height="211">
        <img class="cbx-mech__point" src="{{ 'cbx-point.svg' | asset_url }}" alt="" width="7" height="7">
        <span class="cbx-mech__num cbx-mono">02</span>
      </div>
      <div class="cbx-mech__callout cbx-mech__callout--3" aria-hidden="true">
        <img class="cbx-mech__line" src="{{ 'cbx-hairline-3.svg' | asset_url }}" alt="" width="100" height="191">
        <img class="cbx-mech__point" src="{{ 'cbx-point.svg' | asset_url }}" alt="" width="7" height="7">
        <span class="cbx-mech__num cbx-mono">03</span>
      </div>

      {%- comment -%} Mobile hotspots (point + numeral only) {%- endcomment -%}
      <div class="cbx-mech__spot cbx-mech__spot--1" aria-hidden="true"><img class="cbx-mech__point" src="{{ 'cbx-point.svg' | asset_url }}" alt="" width="7" height="7"><span class="cbx-mech__num cbx-mono">01</span></div>
      <div class="cbx-mech__spot cbx-mech__spot--2" aria-hidden="true"><img class="cbx-mech__point" src="{{ 'cbx-point.svg' | asset_url }}" alt="" width="7" height="7"><span class="cbx-mech__num cbx-mono">02</span></div>
      <div class="cbx-mech__spot cbx-mech__spot--3" aria-hidden="true"><img class="cbx-mech__point" src="{{ 'cbx-point.svg' | asset_url }}" alt="" width="7" height="7"><span class="cbx-mech__num cbx-mono">03</span></div>
    </div>

    {% assign caption_blocks = blocks | where: 'type', 'caption' %}
    <div class="cbx-mech__captions">
      {% if caption_blocks.size > 0 %}
        {% for block in caption_blocks %}
          <div class="cbx-mech__caption" {{ block.shopify_attributes }}>
            <div class="cbx-mech__rule"></div>
            <p class="cbx-mech__num2 cbx-mono">0{{ forloop.index }}</p>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="cbx-mech__caption"><div class="cbx-mech__rule"></div><p class="cbx-mech__num2 cbx-mono">01</p><h3>A replaceable protective layer</h3><p>Takes routine wear and contact around the outside edge, helping keep it protected.</p></div>
        <div class="cbx-mech__caption"><div class="cbx-mech__rule"></div><p class="cbx-mech__num2 cbx-mono">02</p><h3>Notched to lay flat</h3><p>The cut edge follows the curves of the paddle head and lies flat.</p></div>
        <div class="cbx-mech__caption"><div class="cbx-mech__rule"></div><p class="cbx-mech__num2 cbx-mono">03</p><h3>Trim to fit</h3><p>Ends cleanly at the throat, cut to length during install.</p></div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {%- comment -%} ============ SECTION 4 · REVIEWS ============ {%- endcomment -%}
  {% if s.show_reviews != false %}
  {% assign review_blocks = blocks | where: 'type', 'review' %}
  <section class="cbx-section cbx-section--mist" id="reviews">
    {%- render 'cbx-reviews', title: s.reviews_heading, link_url: s.reviews_link_url, blocks: review_blocks -%}
  </section>
  {% endif %}

  {%- comment -%} ============ RECOMMENDATIONS ============ {%- endcomment -%}
  {% if s.show_recs != false %}
  <section class="cbx-pdp__recs" data-recs>
    <div class="cbx-pdp__recs-inner">
      <h2 class="cbx-h-xl cbx-center">{{ s.recs_heading | default: 'You may also like' | escape }}</h2>
      <div class="cbx-pdp__recs-grid" data-recs-grid>
        {% assign recs_shown = 0 %}
        {% for item in recs_collection.products %}
          {% if item.id != product.id and recs_shown < 4 %}
            <a class="carbex-recs-card" href="{{ item.url }}">
              <div class="carbex-recs-card__media">
                {% if item.featured_image %}{{ item.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: item.title }}{% endif %}
              </div>
              <div class="carbex-recs-card__meta"><h3>{{ item.title | escape }}</h3><span>{{ item.price | money }}</span></div>
            </a>
            {% assign recs_shown = recs_shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {%- comment -%} ============ CLOSING BANNER ============ {%- endcomment -%}
  {% if s.show_closing != false %}
    {%- render 'cbx-closing',
      heading: s.closing_heading,
      text: s.closing_text,
      btn_label: s.closing_button_label,
      btn_url: s.closing_button_link,
      img_d: s.closing_image,
      img_m: s.closing_image_m
    -%}
  {% endif %}

  {% if s.show_sticky_atc != false %}
    <div class="cbx-pdp__sticky">
      <span class="cbx-pdp__sticky-price" data-add-price>{{ current_variant.price | default: 0 | money }}</span>
      <button type="button" class="cbx-pdp__sticky-btn" data-sticky-submit {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}{{ s.add_to_cart_label | default: 'Add to Cart' | escape }}{% else %}{{ s.sold_out_label | default: 'Sold out' | escape }}{% endif %}
      </button>
    </div>
  {% endif %}
</div>

<script>
  (() => {
    const root = document.querySelector('[data-product-id="{{ product.id }}"]');
    if (!root) return;

    /* ---- Gallery ---- */
    const images = [...root.querySelectorAll('[data-gallery-image]')];
    root.querySelectorAll('[data-gallery-thumb]').forEach((button) => {
      button.addEventListener('click', () => {
        const index = button.dataset.galleryThumb;
        images.forEach((image) => image.classList.toggle('is-hidden', image.dataset.galleryImage !== index));
        root.querySelectorAll('[data-gallery-thumb]').forEach((thumb) => {
          const active = thumb === button;
          thumb.classList.toggle('is-active', active);
          thumb.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      });
    });

    /* ---- Variants ---- */
    const select = root.querySelector('[data-variant-select]');
    const variants = {{ product.variants | json }} || [];
    const selected = [{% for option in product.options_with_values %}{{ option.selected_value | json }}{% unless forloop.last %},{% endunless %}{% endfor %}];

    const resolveVariant = () => variants.find((v) => v.options.every((o, i) => o === selected[i]));
    const atc = root.querySelector('.cbx-pdp__atc');
    const addLabel = root.querySelector('[data-add-label]');

    const applyVariant = () => {
      const variant = resolveVariant();
      if (!variant || !select) return;
      select.value = String(variant.id);
      const opt = select.selectedOptions[0];
      if (opt && opt.disabled && atc) {
        atc.disabled = true;
        if (addLabel) addLabel.textContent = {{ s.sold_out_label | default: 'Sold out' | json }};
      } else {
        const available = variant.available !== false;
        if (atc) atc.disabled = !available;
        if (addLabel) addLabel.textContent = available ? {{ s.add_to_cart_label | default: 'Add to Cart' | json }} : {{ s.sold_out_label | default: 'Sold out' | json }};
      }
      updatePrices();
    };

    root.querySelectorAll('[data-option-value]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.closest('[data-option-index]');
        const idx = Number(group.dataset.optionIndex);
        selected[idx] = btn.dataset.optionValue;
        group.querySelectorAll('[data-option-value]').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        const label = group.querySelector('[data-option-value-label]');
        if (label) label.textContent = btn.dataset.optionValue;
        applyVariant();
      });
    });

    /* ---- Live pricing ---- */
    const qtyInput = root.querySelector('[name="quantity"]');
    const bundleBoxes = [...root.querySelectorAll('[data-bundle-item]')];
    const moneySample = {{ current_variant.price | default: 0 | money | json }};
    const moneyMatch = moneySample.match(/\d[\d\s.,']*/);
    const moneyPrefix = moneyMatch ? moneySample.slice(0, moneyMatch.index) : '';
    const moneySuffix = moneyMatch ? moneySample.slice(moneyMatch.index + moneyMatch[0].length) : '';
    const money = (cents) => moneyPrefix + (cents / 100).toLocaleString(document.documentElement.lang || 'en', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + moneySuffix;

    const updatePrices = () => {
      const variant = resolveVariant();
      const unitCents = variant ? variant.price : {{ current_variant.price | default: 0 }};
      const qty = qtyInput ? Math.max(1, Number(qtyInput.value) || 1) : 1;
      const bundleCents = bundleBoxes.reduce((sum, b) => sum + (b.checked ? Number(b.dataset.cents) : 0), 0);
      const priceEl = root.querySelector('[data-product-price]');
      if (priceEl && variant) priceEl.textContent = money(unitCents);
      root.querySelectorAll('[data-add-price]').forEach((p) => { p.textContent = money(unitCents * qty + bundleCents); });
    };

    root.querySelectorAll('[data-qty-change]').forEach((btn) => btn.addEventListener('click', () => {
      if (!qtyInput) return;
      qtyInput.value = Math.max(1, (Number(qtyInput.value) || 1) + Number(btn.dataset.qtyChange));
      qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
    }));
    [select, qtyInput, ...bundleBoxes].forEach((el) => el && el.addEventListener('change', updatePrices));
    if (qtyInput) qtyInput.addEventListener('input', updatePrices);
    updatePrices();

    /* ---- Add to cart (handles bundle items via AJAX) ---- */
    const form = root.querySelector('.cbx-pdp__form');
    const formMessage = root.querySelector('.cbx-pdp__msg');
    const stickySubmit = root.querySelector('[data-sticky-submit]');
    if (stickySubmit && form) stickySubmit.addEventListener('click', () => form.requestSubmit());
    if (form) form.addEventListener('submit', async (event) => {
      const checked = [...root.querySelectorAll('[data-bundle-item]:checked')];
      if (!checked.length) return;
      event.preventDefault();
      const data = new FormData(form);
      const items = [{ id: Number(data.get('id')), quantity: Number(data.get('quantity')) || 1 }]
        .concat(checked.map((box) => ({ id: Number(box.value), quantity: 1 })));
      try {
        const response = await fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items }),
        });
        if (!response.ok) throw new Error('add failed');
        window.location.href = '{{ routes.cart_url }}';
      } catch (error) {
        if (formMessage) formMessage.textContent = {{ s.error_message | default: 'Something went wrong — please try again.' | json }};
      }
    });

    /* ---- Recommendations ---- */
    const recs = root.querySelector('[data-recs]');
    if (recs) {
      fetch('{{ routes.product_recommendations_url }}?section_id=carbex-recommendations&product_id={{ product.id }}&limit=4&intent=related')
        .then((res) => res.text())
        .then((html) => {
          const cards = new DOMParser().parseFromString(html, 'text/html').querySelectorAll('.carbex-recs-card');
          if (cards.length) {
            const grid = recs.querySelector('[data-recs-grid]');
            grid.innerHTML = '';
            cards.forEach((card) => grid.appendChild(card));
          }
        })
        .catch(() => {});
    }
  })();
</script>

