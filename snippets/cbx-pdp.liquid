{%- render 'cbx-theme' -%}
{% liquid
  assign s = s | default: section.settings
  assign section_id = section_id | default: section.id
  assign blocks = blocks | default: section.blocks
  if product == blank
    assign product = all_products['carbex-lab-pickleball-paddle-edge-guard-tape'] | default: collections.all.products.first
  endif
%}

{%- render 'cbx-sec-pdpmain', product: product, s: s, blocks: blocks, section_id: section_id -%}

{%- comment -%} ============ REVIEWS ============ {%- endcomment -%}
{% if s.show_reviews != false %}
{% assign review_blocks = blocks | where: 'type', 'review' %}
<section class="cbx-section cbx-section--mist cbx-page" id="reviews">
  {%- render 'cbx-reviews', title: s.reviews_heading, link_url: s.reviews_link_url, blocks: review_blocks -%}
</section>
{% endif %}

{%- render 'cbx-sec-recs', product: product, s: s -%}

{% if s.show_closing != false %}
<div class="cbx-page">
  {%- render 'cbx-closing',
    heading: s.closing_heading,
    text: s.closing_text,
    btn_label: s.closing_button_label,
    btn_url: s.closing_button_link,
    img_d: s.closing_image,
    img_m: s.closing_image_m
  -%}
</div>
{% endif %}
