{%- render 'cbx-theme' -%}
{%- assign s = s | default: section.settings -%}
{%- assign blocks = blocks | default: section.blocks -%}

<div class="cbx-page">
  {%- comment -%} ============ 1 · HERO ============ {%- endcomment -%}
  {%- assign hero_img_d = s.hero_image | default: 'cbx-hero-desktop.png' -%}
  {%- assign hero_img_m = s.hero_image_m | default: 'cbx-hero-mobile.png' -%}
  {%- assign hero_hd = s.hero_height_d | default: 680 -%}
  {%- assign hero_hm = s.hero_height_m | default: 538 -%}
  {%- assign hero_head = s.hero_heading | default: 'Practical protection and care for pickleball equipment.' -%}
  {%- assign hero_txt = s.hero_text | default: 'CARBEX LAB is a pickleball paddle care and protection brand. We make practical products that help players protect, clean, and maintain the equipment they use.' -%}
  {%- assign hero_dt = s.hero_dots | default: true -%}
  {%- render 'cbx-band',
    band_cls: 'cbx-hero',
    copy_cls: 'cbx-hero__copy',
    band_h: hero_hd,
    band_hm: hero_hm,
    focal: s.hero_focal,
    img_d: hero_img_d,
    img_m: hero_img_m,
    heading: hero_head,
    heading_tag: 'h1',
    heading_cls: 'cbx-h-hero',
    text: hero_txt,
    btn_label: s.hero_btn1_label,
    btn_url: s.hero_btn1_url,
    btn_style: 'white',
    btn2_label: s.hero_btn2_label,
    btn2_url: s.hero_btn2_url,
    btn2_style: 'ghost',
    dots: hero_dt,
    fetchpriority: 'high'
  -%}

  {%- comment -%} ============ 2 · SHOP CARDS ============ {%- endcomment -%}
  {%- render 'cbx-sec-cards', s: s -%}

  {%- comment -%} ============ 3 · ABOUT BAND ============ {%- endcomment -%}
  {%- assign band_img_d_v = s.band_image | default: 'cbx-band-about-desktop.png' -%}
  {%- assign band_img_m_v = s.band_image_m | default: 'cbx-band-about-mobile.png' -%}
  {%- assign band_eyebrow_v = s.band_eyebrow | default: 'About' -%}
  {%- assign band_heading_v = s.band_heading | default: 'Built Around Better Paddle Care' -%}
  {%- assign band_text_v = s.band_text | default: 'Simple products built around how paddles actually wear.' -%}
  {%- assign band_btn_v = s.band_btn | default: 'Learn More About Us' -%}
  {%- assign band_btn_url_v = s.band_btn_url | default: '/pages/about-us' -%}
  {%- render 'cbx-band',
    band_h: 600,
    band_hm: 430,
    focal: '58% 40%',
    tight: true,
    img_d: band_img_d_v,
    img_m: band_img_m_v,
    eyebrow: band_eyebrow_v,
    eyebrow_mod: 'light',
    heading: band_heading_v,
    text: band_text_v,
    btn_label: band_btn_v,
    btn_url: band_btn_url_v,
    btn_style: 'white'
  -%}

  {%- comment -%} ============ 4 · REVIEWS ============ {%- endcomment -%}
  {%- assign review_blocks = blocks | where: 'type', 'review' -%}
  <section class="cbx-section cbx-section--mist" id="reviews">
    {%- render 'cbx-reviews',
      title: s.reviews_heading,
      link_url: s.reviews_link_url,
      blocks: review_blocks
    -%}
  </section>

  {%- comment -%} ============ 5 · GALLERY ============ {%- endcomment -%}
  {%- render 'cbx-sec-gallery', s: s -%}

  {%- comment -%} ============ 6 · FAQ ============ {%- endcomment -%}
  {%- assign faq_blocks = blocks | where: 'type', 'faq' -%}
  {%- render 'cbx-sec-faqwrap',
    s: s,
    blocks: faq_blocks,
    mist: true
  -%}

  {%- comment -%} ============ 7 · CLOSING BANNER ============ {%- endcomment -%}
  {%- render 'cbx-closing',
    heading: s.closing_heading,
    text: s.closing_text,
    btn_label: s.closing_btn,
    btn_url: s.closing_btn_url,
    img_d: s.closing_image,
    img_m: s.closing_image_m
  -%}
</div>

<style>
  .cbx-hero__copy { gap: 30px; top: 108px; bottom: auto; justify-content: flex-start; }
  @media screen and (max-width: 989px) {
    .cbx-hero__copy { gap: 16px; }
    .cbx-hero__copy .cbx-btn-row { flex-direction: column; gap: 10px; }
  }
</style>
