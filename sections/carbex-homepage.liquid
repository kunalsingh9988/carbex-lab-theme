{%- render 'cbx-theme' -%}
{%- assign s = section.settings -%}
{%- assign product_1 = all_products[s.product_1] -%}

<div class="cbx-page">
  {%- comment -%} ============ 1 · HERO ============ {%- endcomment -%}
  <section class="cbx-band cbx-on-dark cbx-hero" style="--band-h: 680px; --band-hm: 538px;">
    <div class="cbx-band__media">
      <picture>
        <source media="(max-width: 989px)" srcset="{% if s.hero_image_m != blank %}{{ s.hero_image_m | image_url: width: 1080 }}{% else %}{{ 'cbx-hero-mobile.png' | asset_url }}{% endif %}">
        {%- if s.hero_image != blank -%}
          <img src="{{ s.hero_image | image_url: width: 1920 }}" srcset="{{ s.hero_image | image_url: width: 1200 }} 1200w, {{ s.hero_image | image_url: width: 1920 }} 1920w" sizes="100vw" alt="{{ s.hero_heading | escape }}" width="1920" height="680" fetchpriority="high">
        {%- else -%}
          <img src="{{ 'cbx-hero-desktop.png' | asset_url }}" alt="{{ s.hero_heading | escape }}" width="1920" height="680" fetchpriority="high">
        {%- endif -%}
      </picture>
    </div>
    <div class="cbx-band__grad"></div>
    <div class="cbx-band__copy cbx-hero__copy">
      <h1 class="cbx-h-hero">{{ s.hero_heading | default: 'Practical protection and care for pickleball equipment.' }}</h1>
      <p class="cbx-lead">{{ s.hero_text | default: 'CARBEX LAB is a pickleball paddle care and protection brand. We make practical products that help players protect, clean, and maintain the equipment they use.' }}</p>
      <div class="cbx-btn-row">
        {%- if s.hero_btn1_label != blank -%}
          <a class="cbx-btn cbx-btn--white" href="{{ s.hero_btn1_url | default: routes.all_products_collection_url }}">{{ s.hero_btn1_label }}</a>
        {%- endif -%}
        {%- if s.hero_btn2_label != blank -%}
          <a class="cbx-btn cbx-btn--ghost" href="{{ s.hero_btn2_url | default: routes.all_products_collection_url }}">{{ s.hero_btn2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ 2 · SHOP CARDS ============ {%- endcomment -%}
  <section class="cbx-section cbx-section--wide cbx-shop">
    <h2 class="cbx-h-xl cbx-center cbx-shop__title">{{ s.shop_heading | default: 'Shop CARBEX LAB' }}</h2>
    <div class="cbx-shop__grid">
      {%- comment -%} Card 1 — product-driven {%- endcomment -%}
      <div class="cbx-card">
        <a class="cbx-card__media" href="{{ product_1.url | default: '#' }}">
          {%- if s.card1_image != blank -%}
            <img src="{{ s.card1_image | image_url: width: 1172 }}" alt="{{ s.card1_title | escape }}" width="586" height="586" loading="lazy">
          {%- elsif product_1.featured_image -%}
            <img src="{{ product_1.featured_image | image_url: width: 1172 }}" alt="{{ product_1.title | escape }}" width="586" height="586" loading="lazy">
          {%- else -%}
            <img src="{{ 'cbx-card-paddle.png' | asset_url }}" alt="{{ s.card1_title | escape }}" width="586" height="586" loading="lazy">
          {%- endif -%}
        </a>
        <div class="cbx-card__body">
          <h3 class="cbx-h-sm">{{ s.card1_title | default: product_1.title | default: 'Paddle Edge Guard Tape' }}</h3>
          <p class="cbx-card__desc">{{ s.card1_desc | default: 'A replaceable protective layer applied around the outside edge of a pickleball paddle.' }}</p>
          <p class="cbx-card__price">
            {%- if product_1 != blank -%}
              {%- assign opt = product_1.options_with_values.first -%}
              {%- if product_1.variants.size > 1 and opt.values.size > 1 -%}
                {{ opt.values | join: ' or ' }} · {{ product_1.price | money }}
              {%- else -%}
                {{ product_1.price | money }}
              {%- endif -%}
            {%- else -%}
              {{ s.card1_price | default: '26 mm or 30 mm · $15.99' }}
            {%- endif -%}
          </p>
          <a class="cbx-btn cbx-btn--dark cbx-card__btn" href="{{ product_1.url | default: routes.all_products_collection_url }}">{{ s.card1_btn | default: 'Shop Edge Guard' }}</a>
        </div>
      </div>

      {%- comment -%} Card 2 — coming soon {%- endcomment -%}
      <div class="cbx-card">
        <div class="cbx-card__media">
          {%- if s.card2_image != blank -%}
            <img src="{{ s.card2_image | image_url: width: 1172 }}" alt="{{ s.card2_title | escape }}" width="586" height="586" loading="lazy">
          {%- else -%}
            <img src="{{ 'cbx-card-cleaner.png' | asset_url }}" alt="{{ s.card2_title | escape }}" width="586" height="586" loading="lazy">
          {%- endif -%}
        </div>
        <div class="cbx-card__body">
          <h3 class="cbx-h-sm">{{ s.card2_title | default: 'Paddle Surface Cleaner' }}</h3>
          <p class="cbx-card__desc">{{ s.card2_desc | default: 'Remove everyday dirt and grime without overcomplicating paddle care.' }}</p>
          <p class="cbx-card__tag">{{ s.card2_tag | default: 'Coming soon' }}</p>
          <a class="cbx-btn cbx-btn--outline cbx-card__btn" href="{{ s.card2_btn_url | default: routes.root_url | append: 'pages/contact' }}">{{ s.card2_btn | default: 'Notify me' }}</a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 3 · ABOUT BAND ============ {%- endcomment -%}
  {%- assign band_img_d_v = s.band_image | default: 'cbx-band-about-desktop.png' -%}
  {%- assign band_img_m_v = s.band_image_m | default: 'cbx-band-about-mobile.png' -%}
  {%- assign band_eyebrow_v = s.band_eyebrow | default: 'About' -%}
  {%- assign band_heading_v = s.band_heading | default: 'Built Around Better Paddle Care' -%}
  {%- assign band_text_v = s.band_text | default: 'Simple products built around how paddles actually wear.' -%}
  {%- assign band_btn_v = s.band_btn | default: 'Learn More About Us' -%}
  {%- assign band_btn_url_v = s.band_btn_url | default: '/pages/about-us' -%}
  {%- render 'cbx-band',
    band_h: 600,
    band_hm: 430,
    focal: '58% 40%',
    tight: true,
    img_d: band_img_d_v,
    img_m: band_img_m_v,
    eyebrow: band_eyebrow_v,
    eyebrow_mod: 'light',
    heading: band_heading_v,
    text: band_text_v,
    btn_label: band_btn_v,
    btn_url: band_btn_url_v,
    btn_style: 'white'
  -%}

  {%- comment -%} ============ 4 · REVIEWS ============ {%- endcomment -%}
  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  <section class="cbx-section cbx-section--mist" id="reviews">
    {%- render 'cbx-reviews',
      title: s.reviews_heading,
      link_url: s.reviews_link_url,
      blocks: review_blocks
    -%}
  </section>

  {%- comment -%} ============ 5 · GALLERY ============ {%- endcomment -%}
  <section class="cbx-section cbx-gallery">
    <h2 class="cbx-h-xl cbx-center">{{ s.gallery_heading | default: 'On the court' }}</h2>
    <div class="cbx-gallery__grid">
      {%- for i in (1..6) -%}
        {%- assign key = 'tile_' | append: i -%}
        {%- assign tile = s[key] -%}
        <div class="cbx-gallery__tile">
          {%- if tile != blank -%}
            <img src="{{ tile | image_url: width: 980 }}" alt="CARBEX LAB on the court {{ i }}" width="490" height="490" loading="lazy">
          {%- else -%}
            <img src="{{ 'cbx-court-' | append: i | append: '.png' | asset_url }}" alt="CARBEX LAB on the court {{ i }}" width="490" height="490" loading="lazy">
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="cbx-gallery__credit">
      {%- if s.gallery_credit_url != blank -%}
        <a href="{{ s.gallery_credit_url }}" target="_blank" rel="noopener">{{ s.gallery_credit | default: 'Photo: Pickleland' }}</a>
      {%- else -%}
        <span>{{ s.gallery_credit | default: 'Photo: Pickleland' }}</span>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ============ 6 · FAQ ============ {%- endcomment -%}
  {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
  <section class="cbx-section cbx-section--mist" id="carbex-faq">
    <div class="cbx-faqwrap">
      <div class="cbx-faqwrap__side">
        <h2 class="cbx-h-xl">{{ s.faq_heading | default: 'Frequently asked questions' }}</h2>
        <a class="cbx-faqwrap__more" href="{{ s.faq_more_url | default: '/pages/faq' }}">{{ s.faq_more_label | default: 'See all FAQs →' }}</a>
      </div>
      <div class="cbx-faqwrap__acc">
        {%- render 'cbx-faq-items', blocks: faq_blocks, open_first: true -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ 7 · CLOSING BANNER ============ {%- endcomment -%}
  {%- render 'cbx-closing',
    heading: s.closing_heading,
    text: s.closing_text,
    btn_label: s.closing_btn,
    btn_url: s.closing_btn_url,
    img_d: s.closing_image,
    img_m: s.closing_image_m
  -%}
</div>

<style>
  .cbx-hero__copy { gap: 30px; top: 108px; bottom: auto; justify-content: flex-start; padding-top: 0; }


  .cbx-shop { display: flex; flex-direction: column; gap: 30px; align-items: center; }
  .cbx-shop__title { margin-bottom: 0; }
  .cbx-shop__grid { display: flex; gap: 30px; justify-content: center; align-items: stretch; }
  .cbx-card { background: var(--cbx-mist); width: 586px; display: flex; flex-direction: column; overflow: hidden; }
  .cbx-card__media { display: block; aspect-ratio: 1; overflow: hidden; }
  .cbx-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .cbx-card__body { display: flex; flex-direction: column; gap: 14px; padding: 30px 30px 36px; align-items: flex-start; flex: 1; }
  .cbx-card__desc { font-size: 18px; line-height: 28px; color: var(--cbx-body); margin: 0; }
  .cbx-card__price { font-size: 20px; font-weight: 600; line-height: 30px; margin: 0; }
  .cbx-card__tag { font-size: 14px; font-weight: 600; line-height: 20px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--cbx-muted); margin: 0; }
  .cbx-card__btn { margin-top: 6px; }

  .cbx-gallery { display: flex; flex-direction: column; gap: 50px; align-items: center; }
  .cbx-gallery__grid { display: grid; grid-template-columns: repeat(3, 490px); gap: 25px; }
  .cbx-gallery__tile { overflow: hidden; aspect-ratio: 1; }
  .cbx-gallery__tile img { width: 100%; height: 100%; object-fit: cover; }
  .cbx-gallery__credit { width: 100%; }
  .cbx-gallery__credit a, .cbx-gallery__credit span { font-size: 14px; line-height: 20px; color: var(--cbx-muted); }
  .cbx-gallery__credit a:hover { color: var(--cbx-teal); }

  @media screen and (max-width: 1280px) {
    .cbx-gallery__grid { grid-template-columns: repeat(3, 1fr); width: 100%; }
    .cbx-card { width: calc(50% - 15px); }
    .cbx-shop__grid { width: 100%; }
  }
  @media screen and (max-width: 989px) {
    .cbx-hero__copy { gap: 16px; }
    .cbx-hero__copy .cbx-btn-row { flex-direction: column; gap: 10px; }


    /* Cards become horizontal rows */
    .cbx-shop__grid { flex-direction: column; gap: 12px; }
    .cbx-card { flex-direction: row; align-items: stretch; width: 100%; }
    .cbx-card__media { width: 140px; flex: none; aspect-ratio: auto; }
    .cbx-card__media img { height: 100%; }
    .cbx-card__body { padding: 16px; gap: 8px; }
    .cbx-card .cbx-h-sm { font-size: 18px; line-height: 26px; }
    .cbx-card__desc { display: none; }
    .cbx-card__price { font-size: 16px; line-height: 24px; }
    .cbx-card__tag { font-size: 12px; line-height: 18px; letter-spacing: 1.2px; }
    .cbx-card__btn { margin-top: 2px; font-size: 14px; line-height: 20px; padding: 10px 20px; }

    .cbx-gallery { gap: 24px; }
    .cbx-gallery__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  }
</style>

{% schema %}
{
  "name": "Carbex homepage",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type": "text", "id": "source", "label": "Source", "default": "Verified Amazon review"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "text", "label": "Quote"},
        {"type": "text", "id": "author", "label": "Author"}
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {"type": "text", "id": "question", "label": "Question"},
        {"type": "textarea", "id": "answer", "label": "Answer"}
      ]
    },
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        {"type": "text", "id": "icon_asset", "label": "Icon asset"},
        {"type": "text", "id": "icon", "label": "Icon"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "text", "label": "Text"}
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "text", "id": "number", "label": "Number"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "text", "label": "Text"}
      ]
    },
    {
      "type": "step",
      "name": "Install step",
      "settings": [
        {"type": "text", "id": "number", "label": "Number"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "text", "label": "Text"}
      ]
    },
    {
      "type": "compare",
      "name": "Compare row",
      "settings": [
        {"type": "text", "id": "left", "label": "Left"},
        {"type": "text", "id": "right", "label": "Right"}
      ]
    }
  ],
  "settings": [
    {"type": "header", "content": "Hero"},
    {"type": "image_picker", "id": "hero_image", "label": "Desktop hero image"},
    {"type": "image_picker", "id": "hero_image_m", "label": "Mobile hero image"},
    {"type": "text", "id": "hero_heading", "label": "Heading", "default": "Practical protection and care for pickleball equipment."},
    {"type": "textarea", "id": "hero_text", "label": "Text", "default": "CARBEX LAB is a pickleball paddle care and protection brand. We make practical products that help players protect, clean, and maintain the equipment they use."},
    {"type": "text", "id": "hero_btn1_label", "label": "Primary button", "default": "Shop CARBEX LAB"},
    {"type": "url", "id": "hero_btn1_url", "label": "Primary link"},
    {"type": "text", "id": "hero_btn2_label", "label": "Secondary button", "default": "Explore Products"},
    {"type": "url", "id": "hero_btn2_url", "label": "Secondary link"},
    {"type": "header", "content": "Shop cards"},
    {"type": "text", "id": "shop_heading", "label": "Heading", "default": "Shop CARBEX LAB"},
    {"type": "product", "id": "product_1", "label": "Product card 1"},
    {"type": "image_picker", "id": "card1_image", "label": "Card 1 image (overrides product image)"},
    {"type": "text", "id": "card1_title", "label": "Card 1 title (overrides product title)"},
    {"type": "textarea", "id": "card1_desc", "label": "Card 1 description", "default": "A replaceable protective layer applied around the outside edge of a pickleball paddle."},
    {"type": "text", "id": "card1_price", "label": "Card 1 price fallback", "default": "26 mm or 30 mm · $15.99"},
    {"type": "text", "id": "card1_btn", "label": "Card 1 button", "default": "Shop Edge Guard"},
    {"type": "image_picker", "id": "card2_image", "label": "Card 2 image"},
    {"type": "text", "id": "card2_title", "label": "Card 2 title", "default": "Paddle Surface Cleaner"},
    {"type": "textarea", "id": "card2_desc", "label": "Card 2 description", "default": "Remove everyday dirt and grime without overcomplicating paddle care."},
    {"type": "text", "id": "card2_tag", "label": "Card 2 tag", "default": "Coming soon"},
    {"type": "text", "id": "card2_btn", "label": "Card 2 button", "default": "Notify me"},
    {"type": "url", "id": "card2_btn_url", "label": "Card 2 button link"},
    {"type": "header", "content": "About band"},
    {"type": "image_picker", "id": "band_image", "label": "Desktop image"},
    {"type": "image_picker", "id": "band_image_m", "label": "Mobile image"},
    {"type": "text", "id": "band_eyebrow", "label": "Eyebrow", "default": "About"},
    {"type": "text", "id": "band_heading", "label": "Heading", "default": "Built Around Better Paddle Care"},
    {"type": "textarea", "id": "band_text", "label": "Text", "default": "Simple products built around how paddles actually wear."},
    {"type": "text", "id": "band_btn", "label": "Button", "default": "Learn More About Us"},
    {"type": "url", "id": "band_btn_url", "label": "Button link"},
    {"type": "header", "content": "Reviews"},
    {"type": "text", "id": "reviews_heading", "label": "Heading", "default": "Real reviews from players"},
    {"type": "url", "id": "reviews_link_url", "label": "Amazon reviews link"},
    {"type": "header", "content": "Gallery"},
    {"type": "text", "id": "gallery_heading", "label": "Heading", "default": "On the court"},
    {"type": "image_picker", "id": "tile_1", "label": "Tile 1"},
    {"type": "image_picker", "id": "tile_2", "label": "Tile 2"},
    {"type": "image_picker", "id": "tile_3", "label": "Tile 3"},
    {"type": "image_picker", "id": "tile_4", "label": "Tile 4"},
    {"type": "image_picker", "id": "tile_5", "label": "Tile 5"},
    {"type": "image_picker", "id": "tile_6", "label": "Tile 6"},
    {"type": "text", "id": "gallery_credit", "label": "Credit text", "default": "Photo: Pickleland"},
    {"type": "url", "id": "gallery_credit_url", "label": "Credit link"},
    {"type": "header", "content": "FAQ"},
    {"type": "text", "id": "faq_heading", "label": "Heading", "default": "Frequently asked questions"},
    {"type": "text", "id": "faq_more_label", "label": "Link label", "default": "See all FAQs →"},
    {"type": "url", "id": "faq_more_url", "label": "Link"},
    {"type": "header", "content": "Closing banner"},
    {"type": "image_picker", "id": "closing_image", "label": "Desktop image"},
    {"type": "image_picker", "id": "closing_image_m", "label": "Mobile image"},
    {"type": "text", "id": "closing_heading", "label": "Heading", "default": "Keep Your Gear Ready for the Next Point."},
    {"type": "textarea", "id": "closing_text", "label": "Text", "default": "Replaceable protective layer that takes routine wear and contact instead of the exposed paddle edge."},
    {"type": "text", "id": "closing_btn", "label": "Button", "default": "Explore Products"},
    {"type": "url", "id": "closing_btn_url", "label": "Button link"}
  ],
  "presets": [{"name": "Carbex homepage"}]
}
{% endschema %}
