{"type":"text","id":"pv_cta_label","label":"CTA label","default":"Explore the range"},
{"type":"text","id":"pv_note","label":"Note","default":"Product pricing, variants, and checkout will appear here when this item is created in Shopify."},
{"type":"text","id":"pv_story_eyebrow","label":"Story eyebrow","default":"THE CARBEX DIFFERENCE"},
{"type":"text","id":"pv_story_heading","label":"Story heading","default":"Made to play on."},
{"type":"textarea","id":"pv_story_text","label":"Story text","default":"Clean installation, dependable materials, and a finish that feels considered from the first point to the last."},
{"type":"image_picker","id":"pv_story_image","label":"Story image"}
],"presets":[{"name":"Carbex shop page"}]}
