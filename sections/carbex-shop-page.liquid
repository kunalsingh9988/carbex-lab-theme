{"type":"text","id":"pv_eyebrow","label":"Eyebrow","default":"CARBEX LAB / PROTECTION"},
{"type":"text","id":"pv_title","label":"Fallback product title","default":"26mm Edge Guard Tape"},
{"type":"text","id":"pv_rating","label":"Rating label","default":"4.9 from 120+ players"},
{"type":"textarea","id":"pv_copy","label":"Copy","default":"Lightweight, carbon-fiber-inspired protection made to keep your paddle looking sharp through real court wear."},
{"type":"text","id":"pv_benefit_one_heading","label":"Benefit 1 heading","default":"TotalEdge Armor"},
