{%- render 'cbx-shop', s: section.settings -%}

{% schema %}
{"name":"Carbex shop page","settings":[
{"type":"header","content":"Hero"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CARBEX LAB / SHOP"},
{"type":"text","id":"heading","label":"Heading","default":"Protection for the way you play."},
{"type":"textarea","id":"intro","label":"Intro","default":"Considered materials, clean installation, and practical care for every session."},
{"type":"text","id":"button_label","label":"Button label","default":"Shop the range"},
{"type":"image_picker","id":"hero_image","label":"Hero image"},
{"type":"header","content":"Range intro"},
{"type":"checkbox","id":"show_intro","label":"Show range intro","default":true},
{"type":"text","id":"range_eyebrow","label":"Range eyebrow","default":"THE CARBEX RANGE"},
{"type":"text","id":"range_heading","label":"Range heading","default":"Small upgrades. Better equipment days."},
{"type":"textarea","id":"range_text","label":"Range text","default":"Start with protection, add considered care, and keep your paddle ready for the next point."},
{"type":"header","content":"Product grid"},
{"type":"collection","id":"collection","label":"Product collection"},
{"type":"text","id":"products_heading","label":"Products heading","default":"Shop Carbex Lab"},
{"type":"text","id":"view_all_label","label":"View all label","default":"View all"},
{"type":"text","id":"fallback_card_text","label":"Card fallback text","default":"Practical protection and care for the equipment you trust."},
{"type":"text","id":"empty_label","label":"Empty collection label","default":"No products yet — check back soon."},
{"type":"header","content":"Feature banner"},
{"type":"checkbox","id":"show_feature","label":"Show feature banner","default":true},
{"type":"image_picker","id":"feature_image","label":"Feature image"},
{"type":"text","id":"feature_eyebrow","label":"Feature eyebrow","default":"READY FOR THE NEXT POINT"},
{"type":"text","id":"feature_heading","label":"Feature heading","default":"Keep your gear ready."},
{"type":"textarea","id":"feature_text","label":"Feature text","default":"Reliable protection and care for the equipment you trust."},
{"type":"text","id":"feature_button","label":"Feature button","default":"Explore products"}
],"presets":[{"name":"Carbex shop page"}]}
{% endschema %}
