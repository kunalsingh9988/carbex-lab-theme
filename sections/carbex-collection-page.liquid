<main class="carbex-collection-page"><section class="carbex-collection-hero"><div><p class="carbex-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ collection.title | default: section.settings.heading | escape }}</h1><p>{{ collection.description | default: section.settings.intro }}</p></div>{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2880 | image_tag: loading: 'eager', widths: '1400,2000,2880', alt: collection.title | default: section.settings.heading }}{% else %}<img src="{{ 'carbex-lifestyle-studio.png' | asset_url }}" loading="eager" width="2880" height="1600" alt="{{ collection.title | default: section.settings.heading | escape }}">{% endif %}</section><section class="carbex-collection-products"><div class="carbex-collection-toolbar"><p>{% if collection.products_count > 0 %}{{ collection.products_count }} {{ section.settings.count_label | escape }}{% else %}{{ section.settings.empty_label | escape }}{% endif %}</p><button type="button" aria-label="{{ section.settings.sort_label | escape }}">{{ section.settings.sort_label | escape }} <span aria-hidden="true">&#8964;</span></button></div><div class="carbex-collection-grid">{% if collection.products_count > 0 %}{% for product in collection.products %}<a class="carbex-collection-card" href="{{ product.url }}"><div class="carbex-collection-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'carbex-collection-card__placeholder' }}{% endif %}</div><h2>{{ product.title | escape }}</h2><p>{{ product.price | money }}</p></a>{% endfor %}{% else %}<p class="carbex-collection-empty">{{ section.settings.empty_label | escape }}</p>{% endif %}</div></section></main>
{% stylesheet %}
  .carbex-collection-page { background: #f8f8f8; color: #020202; }
  .carbex-collection-hero { align-items: stretch; background: #0d1622; color: #fff; display: grid; grid-template-columns: .7fr 1.3fr; min-height: min(48vw, 580px); }
  .carbex-collection-hero > div { align-self: center; padding: 64px max(24px, 8vw); }
  .carbex-collection-hero h1 { font-size: clamp(2.5rem, 5vw, 5.5rem); font-weight: 500; letter-spacing: 0; line-height: .98; margin: 0; max-width: 9ch; }
  .carbex-collection-hero p:last-child { color: rgba(255,255,255,.75); line-height: 1.7; margin: 24px 0 0; max-width: 38ch; }
  .carbex-collection-hero .carbex-eyebrow { color: #4dd0e1; }
  .carbex-collection-hero img { display: block; height: 100%; object-fit: cover; width: 100%; }
  .carbex-collection-products { margin: 0 auto; max-width: 1260px; padding: clamp(58px, 8vw, 112px) 24px; }
  .carbex-collection-toolbar { align-items: center; border-bottom: 1px solid rgba(2,2,2,.1); display: flex; justify-content: space-between; margin-bottom: 28px; padding-bottom: 14px; }
  .carbex-collection-toolbar p { color: #3b3f45; font-size: .8rem; margin: 0; }
  .carbex-collection-toolbar button { background: transparent; border: 0; cursor: pointer; font: inherit; font-size: .8rem; padding: 8px 0; }
  .carbex-collection-grid { display: grid; gap: 34px 16px; grid-template-columns: repeat(3, 1fr); }
  .carbex-collection-card__placeholder { display: block; height: 100%; width: 100%; }
  .carbex-collection-empty { color: #3b3f45; font-size: .9rem; grid-column: 1 / -1; margin: 0; padding: 24px 0; }
  .carbex-collection-card { color: inherit; text-decoration: none; }
  .carbex-collection-card__media { aspect-ratio: 1; background: #f8f8f8; overflow: hidden; }
  .carbex-collection-card__media img { display: block; height: 100%; object-fit: cover; transition: transform .3s ease; width: 100%; }
  .carbex-collection-card:hover img { transform: scale(1.03); }
  .carbex-collection-card h2 { font-size: .95rem; margin: 14px 0 6px; }
  .carbex-collection-card p { color: #3b3f45; font-size: .78rem; margin: 0; }
  @media (max-width: 749px) { .carbex-collection-hero { grid-template-columns: 1fr; } .carbex-collection-hero img { min-height: 300px; order: -1; } .carbex-collection-hero > div { padding: 54px 24px 72px; } .carbex-collection-products { padding-inline: 16px; } .carbex-collection-grid { grid-template-columns: repeat(2, 1fr); gap: 28px 12px; } }
{% endstylesheet %}
{% schema %}
{"name":"Carbex collection page","settings":[
{"type":"header","content":"Hero"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CARBEX LAB / COLLECTION"},
{"type":"text","id":"heading","label":"Fallback heading","default":"Shop the range"},
{"type":"textarea","id":"intro","label":"Fallback intro","default":"Protection, care, and considered equipment for the way you play."},
{"type":"image_picker","id":"hero_image","label":"Hero image"},
{"type":"header","content":"Product grid"},
{"type":"text","id":"count_label","label":"Product count label","default":"products"},
{"type":"text","id":"empty_label","label":"Empty collection label","default":"No products yet — check back soon."},
{"type":"text","id":"sort_label","label":"Sort button label","default":"Sort by"}
],"presets":[{"name":"Carbex collection page"}]}
{% endschema %}
