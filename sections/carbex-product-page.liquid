{%- render 'cbx-pdp', product: product, s: section.settings, blocks: section.blocks, section_id: section.id -%}

{% schema %}
{
  "name": "Carbex product page",
  "blocks": [
    {
      "type": "fact",
      "name": "Product fact",
      "settings": [
        {"type": "text", "id": "label", "label": "Label"},
        {"type": "text", "id": "value", "label": "Value"}
      ]
    },
    {
      "type": "caption",
      "name": "Mechanism caption",
      "settings": [
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "text", "label": "Text"}
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type": "text", "id": "source", "label": "Source", "default": "Verified Amazon review"},
        {"type": "textarea", "id": "text", "label": "Quote"},
        {"type": "text", "id": "author", "label": "Author"}
      ]
    }
  ],
  "settings": [
    {"type": "header", "content": "Buy box"},
    {"type": "text", "id": "rating", "label": "Rating line", "default": "4.2 ★ · 206 ratings on Amazon"},
    {"type": "textarea", "id": "description", "label": "Description override (uses product description when blank)"},
    {"type": "text", "id": "width_hint", "label": "Option hint", "default": "30 mm tape for 16 mm paddles · 26 mm tape for 14 mm paddles. Measure your paddle's thickness before ordering."},
    {"type": "checkbox", "id": "show_option_rows", "label": "Show Color + Width rows on single-variant products", "default": true},
    {"type": "text", "id": "color_value", "label": "Color label (no-option products)", "default": "Carbon Blue"},
    {"type": "text", "id": "width_value", "label": "Width label (no-option products)", "default": "30 mm"},
    {"type": "text", "id": "qty_label", "label": "Quantity label", "default": "Quantity"},
    {"type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to Cart"},
    {"type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out"},
    {"type": "text", "id": "error_message", "label": "Error message", "default": "Something went wrong — please try again."},
    {"type": "header", "content": "Quote"},
    {"type": "text", "id": "quote", "label": "Quote", "default": "“I've been using it for 4months now and it is holding up very well.”"},
    {"type": "text", "id": "quote_cite", "label": "Citation", "default": "Vlad · Verified Amazon review"},
    {"type": "header", "content": "Facts"},
    {"type": "text", "id": "facts_heading", "label": "Facts heading", "default": "Confirmed product facts"},
    {"type": "header", "content": "Bundle"},
    {"type": "checkbox", "id": "show_bundle", "label": "Show bundle products", "default": true},
    {"type": "collection", "id": "bundle_collection", "label": "Bundle collection"},
    {"type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "Make it a bundle"},
    {"type": "header", "content": "Mechanism"},
    {"type": "checkbox", "id": "show_mechanism", "label": "Show mechanism banner", "default": true},
    {"type": "image_picker", "id": "mech_image", "label": "Desktop mechanism image"},
    {"type": "image_picker", "id": "mech_image_m", "label": "Mobile mechanism image"},
    {"type": "header", "content": "Reviews"},
    {"type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true},
    {"type": "text", "id": "reviews_heading", "label": "Heading", "default": "Real reviews from players"},
    {"type": "url", "id": "reviews_link_url", "label": "Amazon reviews link"},
    {"type": "header", "content": "Recommendations"},
    {"type": "checkbox", "id": "show_recs", "label": "Show recommendations", "default": true},
    {"type": "collection", "id": "recs_collection", "label": "Recommendations collection"},
    {"type": "text", "id": "recs_heading", "label": "Heading", "default": "You may also like"},
    {"type": "header", "content": "Closing banner"},
    {"type": "checkbox", "id": "show_closing", "label": "Show closing banner", "default": true},
    {"type": "image_picker", "id": "closing_image", "label": "Desktop image"},
    {"type": "image_picker", "id": "closing_image_m", "label": "Mobile image"},
    {"type": "text", "id": "closing_heading", "label": "Heading", "default": "Keep Your Gear Ready for the Next Point."},
    {"type": "textarea", "id": "closing_text", "label": "Text", "default": "Replaceable protective layer that takes routine wear and contact instead of the exposed paddle edge."},
    {"type": "text", "id": "closing_button_label", "label": "Button label", "default": "Explore Products"},
    {"type": "url", "id": "closing_button_link", "label": "Button link"},
    {"type": "header", "content": "Mobile"},
    {"type": "checkbox", "id": "show_sticky_atc", "label": "Sticky mobile add-to-cart", "default": true}
  ],
  "presets": [{"name": "Carbex product page"}]
}
{% endschema %}
