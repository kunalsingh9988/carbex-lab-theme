

{% if page.handle == 'about-us' or page.handle == 'about' or page.handle == 'why-carbex-lab' %}
  {% render 'carbex-about-body' %}
{% elsif page.handle == 'installation' or page.handle == 'install' or page.handle == 'installation-guide' or page.handle == 'install-guide' %}
  {% render 'cbx-install' %}
{% elsif page.handle == 'faq' or page.handle == 'faqs' or page.handle == 'frequently-asked-questions' %}
  {% render 'cbx-faq' %}
{% elsif page.handle == 'contact' or page.handle == 'contact-us' or page.handle == 'support' %}
  {% render 'cbx-contact' %}
{% elsif page.handle == 'shop' or page.handle == 'store' or page.handle == 'products' or page.handle == 'range' %}
  {% render 'cbx-shop' %}
{% elsif page.handle == 'homepage' or page.handle == 'home' %}
  {% render 'cbx-home' %}
{% elsif page.handle == 'product-page' or page.handle == 'product' or page.handle == 'product-detail' or page.handle == 'edge-guard' or page.handle == 'edge-guard-tape' %}
  {% render 'cbx-pdp' %}
{% else %}
  {% render 'carbex-simple-page' %}
{% endif %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
